{
  "name": "vocabman",
  "version": "1.7.0",
  "description": "语境词汇学习工具 - 基于CEFR分级的雅思词汇学习系统",
  "type": "module",
  "scripts": {
    "audit:ielts": "node scripts/audit-ielts-candidates.js",
    "audit:real": "node scripts/real-audit.cjs",
    "convert": "node scripts/convert-data.js",
    "generate:ielts": "node scripts/generate-core-bundles.js",
    "generate:ielts:draft": "node scripts/generate-core-bundles.js --draft",
    "generate:ielts:topics": "node scripts/generate-topic-pack-drafts.js",
    "finalize:quality": "node scripts/finalize-core-quality.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "qa:ielts": "node scripts/qa-validate-bundles.js",
    "score:ielts": "node scripts/score-ielts-candidates.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "vocabulary",
    "ielts",
    "learning"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.23",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "esbuild": "^0.28.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.8",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.5",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "agentbridge": "github:raysonmeng/agent-bridge",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.3.3",
    "vue": "^3.5.26"
  }
}
